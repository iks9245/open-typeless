# whisper.cpp local ASR server configuration
# Copy this file to .env and adjust as needed (read by `pnpm start` only;
# the packaged app uses saved settings and auto-detection instead)

# URL of the whisper.cpp server (default: http://localhost:8080).
# For localhost URLs the app starts whisper-server itself and stops it on quit;
# if a server already answers at this URL it is used as is and never stopped.
WHISPER_SERVER_URL=http://localhost:8080

# Language hint for whisper (optional — leave unset for auto-detect)
# Examples: zh, en, ja, ko
# WHISPER_LANGUAGE=zh

# ── App-managed whisper-server (optional overrides) ───────────────────────────
# By default the app looks for ~/whisper.cpp/build/bin/whisper-server
# (then /opt/homebrew/bin and /usr/local/bin) and, in ~/whisper.cpp/models,
# ggml-large-v3-turbo / large-v3 / medium / small / base.
# WHISPER_SERVER_BIN=/path/to/whisper-server
# WHISPER_MODEL_PATH=/path/to/ggml-large-v3-turbo.bin

# Silero VAD model; enables --vad when found (default: ~/whisper.cpp/models/ggml-silero-*.bin)
# WHISPER_VAD_MODEL_PATH=/path/to/ggml-silero-v6.2.0.bin

# ── Volcengine cloud ASR (unused by default, kept for reference) ──────────────
# VOLCENGINE_APP_ID=your_app_id_here
# VOLCENGINE_ACCESS_TOKEN=your_access_token_here
# VOLCENGINE_RESOURCE_ID=volc.bigasr.sauc.duration
